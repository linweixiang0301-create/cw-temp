# Copy to .env.local and fill real local values. Never commit .env.local.

# Optional local paths. Leave blank to use built-in defaults.
PS_AUTOMATION_BRIDGE_ROOT=
PS_AUTOMATION_TEMPLATE_ROOTS=
PS_AUTOMATION_MANIFEST_ROOTS=

# Feishu final PNG target, optional.
PS_AUTOMATION_FEISHU_CHAT_ID=
PS_AUTOMATION_FEISHU_USER_ID=

# Model providers. Values below are API keys, not key env names.
GEMINI_TUZI_API_KEY=
GEMINI_FLASH_API_KEY=
GPT55_FLASH_API_KEY=

# Default model routes for fresh local state.
PS_AUTOMATION_IMAGE_MODEL=gpt-image-2
PS_AUTOMATION_IMAGE_FALLBACK_MODEL=gemini-3-pro-image-preview-4k
PS_AUTOMATION_IMAGE_MODEL_SOURCE=tuzi-image-cost-preferred
PS_AUTOMATION_IMAGE_BASE_URL=https://api.tu-zi.com/v1
PS_AUTOMATION_IMAGE_API_KEY_ENV=GEMINI_TUZI_API_KEY

PS_AUTOMATION_VISION_MODEL=gemini-3-flash-preview
PS_AUTOMATION_VISION_FALLBACK_MODEL=gpt-5.5
PS_AUTOMATION_VISION_MODEL_SOURCE=flashapi-vision-dual-credential
PS_AUTOMATION_VISION_BASE_URL=https://ai.flashapi.top
PS_AUTOMATION_VISION_API_KEY_ENV=GEMINI_FLASH_API_KEY
PS_AUTOMATION_VISION_MODEL_API_KEY_ENVS=gpt-5.5=GPT55_FLASH_API_KEY
